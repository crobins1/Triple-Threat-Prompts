# n8n Configuration
N8N_BASE_URL=https://your-n8n-instance.com/webhook
N8N_API_KEY=your_api_key_here_if_using_auth

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Workflow Webhook Endpoints (configured in n8n)
CONTENT_GENERATION_ENDPOINT=/content-strategy-agent
PERFORMANCE_ANALYSIS_ENDPOINT=/content-performance-analysis

# Optional: Rate Limiting
RATE_LIMIT_PER_HOUR=10

# Optional: Logging
LOG_LEVEL=info
LOG_FILE=./logs/agent.log

# Optional: Caching (if implementing caching layer)
CACHE_TTL_SECONDS=86400
REDIS_URL=redis://localhost:6379

# Optional: Database (if storing outputs)
DATABASE_URL=postgresql://user:password@localhost:5432/content_agent

# Optional: Notification Services
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=notifications@yourdomain.com
EMAIL_PASSWORD=your_email_password

# Optional: Analytics
ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Optional: Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Production Settings
NODE_ENV=development
PORT=3000
